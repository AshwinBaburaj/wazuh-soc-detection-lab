<group name="local,syslog,">
    <rule id="100015" level="12">
    <if_sid>5402</if_sid>
    <match>COMMAND=/bin/bash|COMMAND=/bin/sh|COMMAND=/bin/su</match>
    <description>Privilege escalation - sudo to root shell detected on $(hostname)</description>
    <group>privilege_escalation,attack,</group>
  </rule>

  <rule id="100016" level="10">
    <if_sid>5402,5403</if_sid>
    <description>Sudo to root executed - possible privilege escalation attempt</description>
    <group>privilege_escalation,</group>
  </rule>

  <rule id="100010" level="5">
    <hostname>metasploitable</hostname>
    <description>Log received from Metasploitable2 lab host</description>
  </rule>

  <rule id="100011" level="5">
    <hostname>kali</hostname>
    <description>Log received from Kali attacker host</description>
  </rule>

  <rule id="100013" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Multiple failed SSH authentication attempts from same source (possible brute force) - 5 failures in 2 minutes</description>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100014" level="12">
    <if_matched_sid>5760</if_matched_sid>
    <if_sid>5715</if_sid>
    <same_source_ip />
    <description>Successful SSH login after multiple failures from same IP - possible account compromise</description>
    <group>authentication_success,attack,</group>
  </rule>
  
 <rule id="100017" level="10" frequency="5" timeframe="120">
  <if_matched_sid>5503</if_matched_sid>
  <program_name>vsftpd</program_name>
  <same_source_ip />
  <description>FTP brute force: 5 failed logins in 2 minutes</description>
</rule>

<rule id="100018" level="10">
  <if_sid>31100</if_sid>
  <url type="pcre2">(?i)(%27|'|union\s+select|or\s+1=1|--|;--|drop\s+table)</url>
  <description>Web Attack: possible SQL Injection attempt detected</description>
  <group>web,attack,sql_injection,</group>
  <mitre>
    <id>T1190</id>
  </mitre>
</rule>

<rule id="100019" level="10" frequency="20" timeframe="60">
  <if_matched_sid>31101</if_matched_sid> <same_source_ip /> 
  <description>Possible web directory/URL fuzzing: high-volume 404s from single source</description>
  <group>web,attack,recon,</group> <mitre> 
    <id>T1595</id> 
  </mitre>
</rule>
